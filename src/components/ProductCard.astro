---
import { getProduct } from '../lib/products';
const p = getProduct(Astro.props.id);
---
{p && p.inStock && (
  <div class="card">
    <img src={p.image} alt={p.name} loading="lazy" width="120" height="120" />
    <div>
      <strong>{p.name}</strong>
      <div>NT${p.price}（{p.checkedAt} 查價）</div>
      {p.pros?.length ? <div>優點：{p.pros.join('、')}</div> : null}
      {p.cons?.length ? <div>注意：{p.cons.join('、')}</div> : null}
      <a href={p.url} rel="sponsored nofollow noopener" target="_blank" data-product={p.id}>看價格與評價 →</a>
    </div>
  </div>
)}
<style>
  .card { display:flex; gap:12px; background:var(--card); border-radius:8px; padding:12px; margin:16px 0; }
  .card img { flex:none; object-fit:cover; border-radius:6px; }
</style>
